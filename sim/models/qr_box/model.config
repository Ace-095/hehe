<?xml version="1.0" ?>
<model>
  <name>qr_box</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <description>
    Intelligence Cache target box for ADDC 2027 simulation.
    A 1m x 1m x 0.1m flat slab with a decodable QR code texture on its top face.
    Placed in the world as a stand-in for the actual physical cache target.

    To regenerate the QR texture:
        cd sim/textures &amp;&amp; python3 generate_qr_texture.py
  </description>
</model>
